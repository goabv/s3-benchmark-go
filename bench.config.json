{
  "bucket": "s3dl-bench-usw2-801400661003",
  "region": "us-west-2",
  "dataPrefix": "bench/",
  "codePrefix": "code-go/",
  "sizes": [{ "size": "200GiB", "count": 1 }],
  "partSize": "32MiB",
  "checksum": "CRC32",

  "download": {
    "workers": 64,
    "concurrency": 8,
    "iterations": 1,
    "warmup": 0,
    "validateChecksum": true,
    "spreadConnections": true,
    "tls": true,
    "deliveryMode": "ordered-stream",
    "deliveryPath": "/tmp",
    "maxBufferedBytes": 68719476736,
    "maxRetries": 2,
    "stallTimeoutMs": 30000
  },

  "upload": {
    "workers": 64,
    "concurrency": 4,
    "iterations": 1,
    "warmup": 0,
    "keyPrefix": "bench-upload/",
    "maxRetries": 2,
    "stallTimeoutMs": 30000
  },

  "transferManager": {
    "download": {
      "api": "download-object",
      "getObjectType": "parts",
      "sink": "discard",
      "deliveryPath": "/mnt/stripe/output",
      "objectConcurrency": 0,
      "concurrency": 640,
      "iterations": 1,
      "warmup": 1,
      "validateChecksum": true,
      "maxBufferedBytes": 68719476736,
      "stallTimeoutMs": 30000
    },
    "upload": {
      "objectConcurrency": 0,
      "concurrency": 640,
      "iterations": 1,
      "warmup": 0,
      "keyPrefix": "tm-upload/",
      "stallTimeoutMs": 30000
    }
  },

  "tmOptimized": {
    "download": {
      "api": "download-object",
      "getObjectType": "parts",
      "sink": "file",
      "deliveryPath": "/mnt/stripe/output",
      "objectConcurrency": 0,
      "concurrency": 640,
      "iterations": 1,
      "warmup": 0,
      "validateChecksum": true,
      "maxBufferedBytes": 68719476736,
      "stallTimeoutMs": 30000,
      "directIO": true
    },
    "upload": {
      "objectConcurrency": 0,
      "concurrency": 640,
      "iterations": 1,
      "warmup": 0,
      "keyPrefix": "tm-upload/",
      "stallTimeoutMs": 30000
    }
  },

  "sampling": {
    "enabled": true,
    "intervalMs": 250
  },

  "results": {
    "dir": "results",
    "plot": true,
    "upload": true,
    "bucket": "",
    "prefix": "results/runs/"
  }
}
