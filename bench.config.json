{
  "bucket": "s3dl-bench-usw2-801400661003",
  "region": "us-west-2",
  "dataPrefix": "bench/",
  "codePrefix": "code-go/",
  "sizes": [{ "size": "1024GiB", "count": 5 }],
  "checksum": "CRC32",
  "memoryLimit": "40GiB",

  "transferManager": {
    "download": {
      "api": "download-file",
      "getObjectType": "ranges",
      "partSize": "8MiB",
      "sink": "file",
      "deliveryPath": "/mnt/stripe/output",
      "objectConcurrency": 5,
      "concurrency": 640,
      "iterations": 1,
      "warmup": 0,
      "validateChecksum": true,
      "maxBufferedBytes": 68719476736,
      "stallTimeoutMs": 30000,
      "multiNIC": false,
      "directIOThreshold": "100MiB",
      "disableDirectIO": false,
      "writeChunkSize": "8MiB",
      "writeFlushWorkers": 16,
      "writeFlushQueueDepth": 64
    },
    "upload": {
      "objectConcurrency": 5,
      "concurrency": 640,
      "partSize": "128MiB",
      "iterations": 1,
      "warmup": 0,
      "keyPrefix": "tm-upload/",
      "stallTimeoutMs": 30000
    }
  },

  "sampling": {
    "enabled": true,
    "intervalMs": 250
  },

  "results": {
    "dir": "results",
    "plot": true,
    "upload": true,
    "bucket": "",
    "prefix": "results/runs/"
  }
}
